# Backend (Render / uvicorn)
DATATEM_BASE_URL=https://app-gateway.brcaptura.com.br
DATATEM_USERNAME=seu-usuario-datatem
DATATEM_PASSWORD=sua-senha-datatem
DATATEM_CLIENT_ID=seu-client-id
DATATEM_CLIENT_SECRET=seu-client-secret
DATATEM_REFRESH_GRANT_TYPE=refresh_token
DATATEM_PAGE_SIZE=100
DATATEM_MAX_PAGES=100
DATATEM_REQUEST_TIMEOUT=30
DATATEM_TOKEN_EXPIRY_SKEW=60
DATATEM_TOKEN_COLLECTION=datatemIntegration
DATATEM_TOKEN_DOCUMENT=session
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://SEU-APP.web.app
FIREBASE_PROJECT_ID=podsadministrator
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Alternativa local: GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\para\service-account.json

# API de pesquisa/ETL (Render)
PORT=3001
GROQ_API_KEY=sua-chave-groq
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://SEU-APP.web.app

# Frontend (Vite) - apenas valores publicos
VITE_DATATEM_API_URL=http://localhost:8000
